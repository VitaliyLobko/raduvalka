{
  "id": "/raduvalka/",
  "name": "Радовалка",
  "short_name": "Радовалка",
  "description": "Письма, конверты и мемчики для двоих",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./?go=shared",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "orientation": "portrait",
  "background_color": "#0B2F40",
  "theme_color": "#EADFFB",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Я в порядке",
      "short_name": "Я в порядке",
      "description": "Отметиться: второму придёт «всё хорошо»",
      "url": "./?do=checkin",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Нужна помощь",
      "short_name": "Помощь",
      "description": "Открыть «Нужна помощь»: дальше провести вправо",
      "url": "./?do=sos",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
